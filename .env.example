# ==============================================================================
# Adyapan AI / AgentCall AI — Root Environment Configuration
# ==============================================================================

# Core Services
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL (Matches docker-compose.yml)
POSTGRES_DB=agentcall_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres_dev_password@localhost:5432/agentcall_db?schema=public"

# Redis (Matches docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=adyapan-dev-jwt-secret-key-change-in-production-2026
JWT_REFRESH_SECRET=adyapan-dev-refresh-secret-key-change-in-production-2026

# Future Integrations (Optional)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
