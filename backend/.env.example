# ==============================================================================
# Adyapan AI / AgentCall AI — Backend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# SECTION 1: REQUIRED FOR LOCAL BACKEND STARTUP
# ------------------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL 15+ / Docker Compose default)
DATABASE_URL="postgresql://postgres:postgres_dev_password@localhost:5432/agentcall_db?schema=public"

# Redis (Redis 7+ / Bull Queue Infrastructure)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (JWT Secrets — Change in production)
JWT_SECRET=adyapan-dev-jwt-secret-key-change-in-production-2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=adyapan-dev-refresh-secret-key-change-in-production-2026
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ------------------------------------------------------------------------------
# SECTION 2: OPTIONAL / INTEGRATION SPECIFIC (Not required for local startup)
# ------------------------------------------------------------------------------

# AI Layer — OpenAI (GPT-4o / Realtime API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Voice Synthesis — ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# Speech-to-Text — Deepgram STT
DEEPGRAM_API_KEY=

# Telephony — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telephony — Exotel (India PSTN)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_SUBDOMAIN=

# Payments — Razorpay (Subscriptions & Invoicing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Object Storage — AWS S3 (Call Recordings & Knowledge Base Documents)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=agentcall-ai-uploads

# Conversational AI — Groq LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Voice Synthesis Provider (elevenlabs | edge-tts)
TTS_PROVIDER=edge-tts

# ------------------------------------------------------------------------------
# SECTION 3: DAY 16 — CRM AUTOMATIONS & OUTBOUND MESSAGING
# ------------------------------------------------------------------------------

# Meta WhatsApp Cloud API (Graph API v20.0)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=agentcall_verify_token_2026
WHATSAPP_APP_SECRET=

# Resend Transactional Email API
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@agentcall.ai

