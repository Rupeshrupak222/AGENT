// ============================================================
// AgentCall AI — Prisma Schema
// Database: PostgreSQL (Supabase)
// ORM: Prisma 5.x
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
  output          = "../backend/node_modules/.prisma/client"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────

enum Plan {
  starter
  growth
  business
  enterprise
}

enum Role {
  super_admin
  company_admin
  manager
  agent
  viewer
}

enum AgentRole {
  telecaller
  recruiter
  receptionist
  collection
  sales
  support
  appointment_setter
}

enum AgentStatus {
  draft
  training
  active
  paused
  archived
}

enum AgentLanguage {
  hindi
  english
  hinglish
  tamil
  telugu
  marathi
  bengali
  gujarati
  kannada
  punjabi
}

enum LeadStatus {
  new
  contacted
  interested
  qualified
  appointment
  closed_won
  closed_lost
}

enum CallStatus {
  queued
  ringing
  in_progress
  completed
  missed
  failed
  transferred
}

enum CallDirection {
  inbound
  outbound
}

enum AutomationType {
  whatsapp
  sms
  email
}

enum AutomationStatus {
  queued
  sent
  delivered
  read
  failed
  skipped
}

enum CampaignStatus {
  draft
  scheduled
  running
  paused
  completed
  cancelled
}

enum CampaignLeadStatus {
  pending
  queued
  calling
  completed
  failed
  skipped
  retry_pending
}

enum RecordingStatus {
  pending
  available
  uploading
  uploaded
  failed
  deleted
}

enum AnalysisStatus {
  pending
  processing
  completed
  failed
  skipped
}

enum IntegrationProvider {
  salesforce
  hubspot
  zoho
  pipedrive
  google_sheets
  slack
  teams
  google_calendar
  outlook_calendar
  whatsapp
  resend
  calcom
}

enum AppointmentStatus {
  scheduled
  pending
  confirmed
  completed
  cancelled
  no_show
  rescheduled
  failed
}

enum AutomationTrigger {
  call_completed
  call_missed
  lead_qualified
  deal_closed
  call_analysis_completed
  lead_disqualified
  appointment_detected
  campaign_lead_completed
  appointment_booked
  appointment_confirmed
  appointment_rescheduled
  appointment_cancelled
  appointment_completed
  appointment_no_show
  appointment_reminder
}

enum AutomationAction {
  whatsapp
  sms
  email
  webhook
  crm_update
  send_whatsapp
  send_email
}

enum AutomationRuleStatus {
  active
  paused
}

// ── Tenant (Company / Workspace) ────────────────────────────

model Tenant {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  logo            String?
  website         String?
  industry        String?
  plan            Plan      @default(starter)
  isActive        Boolean   @default(true)
  subscriptionId  String?
  planExpiresAt   DateTime?
  settings        Json?     @default("{}")
  whitelabelDomain String?

  // Relations
  users         User[]
  agents        AIAgent[]
  leads         Lead[]
  calls         Call[]
  campaigns     Campaign[]
  automations   AutomationLog[]
  automationRules AutomationRule[]
  appointments  Appointment[]
  integrations  Integration[]
  invoices      Invoice[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]
  auditLogs     AuditLog[]
  recordings    CallRecording[]
  analyses      CallAnalysis[]
  phoneNumbers  PhoneNumber[]
  knowledgeSources KnowledgeSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@map("Tenant")
}

// ── User ─────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(agent)
  avatar      String?
  phone       String?
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  settings    Json?    @default("{}")
  mfaEnabled  Boolean  @default(false)
  mfaSecret   String?

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Created resources
  createdAgents   AIAgent[]      @relation("AgentCreatedBy")
  assignedLeads   Lead[]         @relation("LeadAssignedTo")
  auditLogs       AuditLog[]
  createdKnowledgeSources KnowledgeSource[] @relation("KnowledgeCreatedBy")

  // Managers supervise a team of AI agents
  managedAgents   AIAgent[]      @relation("AgentManagedBy")

  // Agent-role users operate AI agents (agent data scoping)
  operatedAgents  AIAgent[]      @relation("AgentOperatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([email])
  @@map("User")
}

// ── AI Agent ──────────────────────────────────────────────────

model AIAgent {
  id                 String        @id @default(cuid())
  name               String
  role               AgentRole
  language           AgentLanguage @default(english)
  voiceId            String
  businessGoal       String
  openingScript      String?       @db.Text
  qualificationRules String?       @db.Text
  knowledgeBase      String?       @db.Text
  status             AgentStatus   @default(draft)
  settings           Json?         @default("{}")
  deletedAt          DateTime?

  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User    @relation("AgentCreatedBy", fields: [createdById], references: [id])

  // Managers supervise a team of agents (manager data scoping)
  managerId String?
  manager   User?   @relation("AgentManagedBy", fields: [managerId], references: [id], onDelete: SetNull)

  // Human agent-role operator bound to this AI agent (agent data scoping)
  operatorUserId String?
  operatorUser   User?   @relation("AgentOperatedBy", fields: [operatorUserId], references: [id], onDelete: SetNull)

  // Relations
  calls       Call[]
  campaigns   Campaign[]
  leads       Lead[]       @relation("LeadAssignedAgent")
  phoneNumbers PhoneNumber[] @relation("PhoneNumberAssignedAgent")
  knowledgeSources KnowledgeSource[] @relation("KnowledgeSourceAgent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([managerId])
  @@index([operatorUserId])
  @@map("AIAgent")
}

// ── Lead ──────────────────────────────────────────────────────

model Lead {
  id          String     @id @default(cuid())
  name        String
  phone       String
  email       String?
  company     String?
  designation String?
  source      String?
  status      LeadStatus @default(new)
  score       Int        @default(0)
  notes       String?    @db.Text
  tags        String[]   @default([])
  metadata    Json?      @default("{}")
  deletedAt   DateTime?

  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assignedAgentId  String?
  assignedAgent    AIAgent? @relation("LeadAssignedAgent", fields: [assignedAgentId], references: [id])

  assignedToId     String?
  assignedTo       User?    @relation("LeadAssignedTo", fields: [assignedToId], references: [id])

  // Relations
  calls         Call[]
  activities    Activity[]
  automations   AutomationLog[]
  campaignLeads CampaignLead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([status])
  @@index([phone])
  @@index([score])
  @@map("Lead")
}

// ── Call ──────────────────────────────────────────────────────

model Call {
  id              String        @id @default(cuid())
  phone           String
  direction       CallDirection @default(outbound)
  status          CallStatus    @default(queued)
  duration        Int?          // seconds
  recordingUrl    String?
  outcome         String?
  sentimentScore  Float?
  qualityScore    Float?
  intentScore     Float?
  transferredTo   String?       // team or phone number
  providerCallId  String?       // Twilio/Exotel SID
  metadata        Json?         @default("{}")

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leadId    String
  lead      Lead    @relation(fields: [leadId], references: [id])

  agentId   String
  agent     AIAgent @relation(fields: [agentId], references: [id])

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  // Relations
  transcript    CallTranscript?
  recordings    CallRecording[]
  analysis      CallAnalysis?
  automations   AutomationLog[]
  campaignLeads CampaignLead[]

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([tenantId])
  @@index([leadId])
  @@index([agentId])
  @@index([status])
  @@index([startedAt])
  @@index([providerCallId])
  @@map("Call")
}

// ── Call Transcript ───────────────────────────────────────────

model CallTranscript {
  id       String @id @default(cuid())
  callId   String @unique
  call     Call   @relation(fields: [callId], references: [id], onDelete: Cascade)
  segments Json   // array of { speaker, text, startTime, endTime }
  summary  String? @db.Text
  keywords String[] @default([])

  createdAt DateTime @default(now())

  @@map("CallTranscript")
}

// ── Call Recording ─────────────────────────────────────────────

model CallRecording {
  id                  String          @id @default(cuid())
  callId              String
  call                Call            @relation(fields: [callId], references: [id], onDelete: Cascade)
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerRecordingId String          // Twilio Recording SID (RExxxx)
  storageProvider     String          @default("cloudflare_r2")
  objectKey           String?
  storageUrl          String?
  mimeType            String          @default("audio/mpeg")
  duration            Int?            // seconds
  size                Int?            // bytes
  status              RecordingStatus @default(pending)
  metadata            Json?           @default("{}")

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([tenantId, providerRecordingId])
  @@index([callId])
  @@index([tenantId])
  @@index([status])
  @@map("CallRecording")
}

// ── Call Analysis ──────────────────────────────────────────────

model CallAnalysis {
  id                  String         @id @default(cuid())
  callId              String         @unique
  call                Call           @relation(fields: [callId], references: [id], onDelete: Cascade)
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadScore           Int?           // 0-100
  intent              String?        // interested, demo_request, etc.
  sentiment           String?        // positive, neutral, negative, mixed, unknown
  summary             String?        @db.Text
  qualification       Json?          // { qualified: boolean, reasons: string[], metCriteria: string[], unmetCriteria: string[] }
  outcome             String?
  nextAction          String?
  appointmentDetected Boolean        @default(false)
  appointmentDetails  Json?          // { topic?: string, date?: string, duration?: number }
  model               String?        // gemini-1.5-flash etc.
  promptVersion       String         @default("v1.0")
  processingStatus    AnalysisStatus @default(pending)
  errorMessage        String?
  processedAt         DateTime?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([tenantId])
  @@index([processingStatus])
  @@map("CallAnalysis")
}

// ── Campaign ──────────────────────────────────────────────────

model Campaign {
  id                 String         @id @default(cuid())
  name               String
  description        String?
  status             CampaignStatus @default(draft)
  scheduledAt        DateTime?
  maxCalls           Int?
  callsPerDay        Int?
  maxConcurrentCalls Int            @default(5)
  maxAttempts        Int            @default(3)
  startTime          String?        // "09:00"
  endTime            String?        // "18:00"
  daysOfWeek         Int[]          @default([1, 2, 3, 4, 5]) // 0=Sun..6=Sat
  metadata           Json?          @default("{}")

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  agentId   String
  agent     AIAgent @relation(fields: [agentId], references: [id])

  // Relations
  calls Call[]
  leads CampaignLead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("Campaign")
}

// ── Campaign Lead (Join Model) ────────────────────────────────

model CampaignLead {
  id            String             @id @default(cuid())
  campaignId    String
  campaign      Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId        String
  lead          Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status        CampaignLeadStatus @default(pending)
  attemptCount  Int                @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  lastCallId    String?
  lastCall      Call?              @relation(fields: [lastCallId], references: [id])
  outcome       String?
  errorMessage  String?
  metadata      Json?              @default("{}")

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
  @@index([leadId])
  @@map("CampaignLead")
}

// ── Activity (CRM timeline) ───────────────────────────────────

model Activity {
  id      String @id @default(cuid())
  type    String // call, note, email, status_change, score_update, whatsapp
  title   String
  body    String? @db.Text
  metadata Json?  @default("{}")

  leadId  String
  lead    Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  tenantId String

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([tenantId])
  @@map("Activity")
}

// ── Automation Log ─────────────────────────────────────────────

model AutomationLog {
  id                String           @id @default(cuid())
  type              AutomationType
  template          String
  message           String           @db.Text
  status            AutomationStatus @default(queued)
  error             String?
  metadata          Json?            @default("{}")
  providerMessageId String?
  attempts          Int              @default(0)

  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leadId    String?
  lead      Lead?  @relation(fields: [leadId], references: [id])

  callId    String?
  call      Call?  @relation(fields: [callId], references: [id])

  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@index([tenantId])
  @@index([type])
  @@index([status])
  @@map("AutomationLog")
}

// ── Appointment (Calendar) ─────────────────────────────────────

model Appointment {
  id        String             @id @default(cuid())
  leadName  String
  phone     String
  email     String?
  topic     String?
  date      DateTime
  duration  Int                @default(30) // minutes
  status    AppointmentStatus  @default(scheduled)

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leadId    String?
  agentId   String?

  // ── Day 17: appointment scheduling (calendar provider layer) ──
  title            String?
  description      String?
  timezone         String   @default("UTC")
  calendarProvider String   @default("native") // native | calcom | google_calendar | outlook_calendar | mock
  providerAppointmentId String?
  providerEventId       String?
  providerBookingUrl    String?
  location              String?
  attendeeEmail         String?
  attendeePhone         String?
  startAt               DateTime?
  endAt                 DateTime?
  metadata              Json     @default("{}")
  source                String   @default("manual") // manual | ai | whatsapp | call
  idempotencyKey        String?
  callId                String?
  campaignId            String?
  confirmationSentAt    DateTime?
  reminder24hSentAt     DateTime?
  reminder1hSentAt      DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  rescheduledAt         DateTime?
  rescheduleReason      String?
  createdById           String?
  createdByEmail        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, startAt])
  @@index([tenantId, providerAppointmentId])
  @@index([date])
  @@index([leadId])
  @@map("Appointment")
}

// ── Automation Rule (config) ───────────────────────────────────

model AutomationRule {
  id         String               @id @default(cuid())
  name       String
  trigger    AutomationTrigger
  action     AutomationAction
  template   String?
  conditions Json?                @default("[]")
  actions    Json?                @default("[]")
  status     AutomationRuleStatus @default(active)
  executions Int                  @default(0)
  lastRunAt  DateTime?

  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("AutomationRule")
}

// ── Integration ────────────────────────────────────────────────

model Integration {
  id          String              @id @default(cuid())
  provider    IntegrationProvider
  isActive    Boolean             @default(false)
  credentials Json                // encrypted in production
  settings    Json?               @default("{}")
  lastSyncAt  DateTime?

  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, provider])
  @@map("Integration")
}

// ── Invoice / Billing ──────────────────────────────────────────

model Invoice {
  id            String   @id @default(cuid())
  amount        Int      // in paise
  currency      String   @default("INR")
  status        String   @default("pending") // pending | paid | failed
  plan          Plan
  razorpayOrderId   String?
  razorpayPaymentId String?
  paidAt        DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("Invoice")
}

// ── API Key ────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique  // bcrypt hash of the actual key
  prefix     String             // first 8 chars shown in UI
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)

  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@map("ApiKey")
}

// ── Webhook ────────────────────────────────────────────────────

model Webhook {
  id         String   @id @default(cuid())
  name       String
  url        String
  events     String[] // call.completed, lead.qualified, etc.
  secret     String
  isActive   Boolean  @default(true)
  failCount  Int      @default(0)

  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@map("Webhook")
}

// ── Phone Number (company telephony inventory) ──────────────
model PhoneNumber {
  id           String   @id @default(cuid())
  number       String
  provider     String   @default("twilio") // twilio | exotel | sandbox
  label        String?
  isInbound    Boolean  @default(true)
  isOutbound   Boolean  @default(true)
  status       String   @default("available") // available | assigned | inactive
  metadata     Json?    @default("{}")

  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assignedAgentId String?
  assignedAgent   AIAgent? @relation("PhoneNumberAssignedAgent", fields: [assignedAgentId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("PhoneNumber")
}

// ── Knowledge Source (company knowledge base) ──────────────
model KnowledgeSource {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("manual") // manual | pdf | docx | txt | url | faq
  content      String?  @db.Text
  sourceUrl    String?
  status       String   @default("ready") // ready | processing | failed | outdated
  tags         String[] @default([])
  lastIndexedAt DateTime?
  errorMessage String?
  agentId      String?
  agent        AIAgent? @relation("KnowledgeSourceAgent", fields: [agentId], references: [id])

  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById  String?
  createdBy    User?    @relation("KnowledgeCreatedBy", fields: [createdById], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@map("KnowledgeSource")
}

// ── Audit Log ──────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // CREATE_AGENT, DELETE_LEAD, UPGRADE_PLAN, etc.
  resource   String
  resourceId String?
  details    Json?    @default("{}")
  ipAddress  String?
  userAgent  String?

  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId     String?
  user       User?  @relation(fields: [userId], references: [id])

  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@map("AuditLog")
}

// ── Platform AI Provider Config ──────────────────────────────
// Global registry of enabled AI providers / model gateways for the platform.
model AiProvider {
  id              String   @id @default(cuid())
  provider        String   @unique // openrouter | groq | azure_openai | anthropic | google | openai
  name            String
  baseUrl         String?
  apiKeyEncrypted String?
  isEnabled       Boolean  @default(true)
  defaultModel    String?
  models          Json?    @default("[]")
  rateLimit       Int      @default(0) // requests / min (0 = unlimited)
  usageCount      Int      @default(0)
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("AiProvider")
}

// ── Platform Telephony Gateway ────────────────────────────────
// Registry of telephony providers (Twilio / Exotel / ...) with health status.
model TelephonyGateway {
  id            String    @id @default(cuid())
  provider      String    @unique // twilio | exotel | plivo | sandbox | custom
  name          String
  isEnabled     Boolean   @default(true)
  settings      Json?     @default("{}")
  healthStatus  String    @default("unknown") // healthy | degraded | down | unknown
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("TelephonyGateway")
}

// ── Plan Pricing (Platform billing templates) ────────────────
model PlanPricing {
  id        String   @id @default(cuid())
  plan      Plan
  currency  String   @default("INR")
  amount    Int      // in paise
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plan, currency])
  @@map("PlanPricing")
}

// ── Role Permission Override ──────────────────────────────────
model RoleOverride {
  id          String   @id @default(cuid())
  role        String   @unique
  permissions Json     // array of permission strings granted for this role
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("RoleOverride")
}

// ── Announcement (platform broadcast) ─────────────────────────
model Announcement {
  id         String    @id @default(cuid())
  title      String
  body       String    @db.Text
  priority   String    @default("info") // info | warning | important
  audience   String    @default("all") // all | specific
  tenantIds  String[]  @default([])
  startsAt   DateTime  @default(now())
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdById String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isActive])
  @@map("Announcement")
}

// ── Support Ticket (platform support inbox) ───────────────────
model SupportTicket {
  id           String   @id @default(cuid())
  subject      String
  body         String   @db.Text
  status       String   @default("open") // open | in_progress | resolved | closed
  priority     String   @default("medium") // low | medium | high | urgent
  tenantId     String?
  tenantName   String?
  tenantEmail  String?
  assignedToId String?
  messages     Json?    @default("[]")
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@map("SupportTicket")
}

// ── IP Allowlist (security) ───────────────────────────────────
model IpAllowlist {
  id          String   @id @default(cuid())
  cidr        String
  label       String?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([cidr])
  @@map("IpAllowlist")
}

// ── Platform Audit Log (super admin actions) ─────────────────
model PlatformAuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String?
  details    Json?    @default("{}")
  ipAddress  String?
  userAgent  String?
  userId     String?
  userEmail  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@map("PlatformAuditLog")
}

// ── Feature Flag (platform-wide capability toggles) ──────────
model FeatureFlag {
  id              String   @id @default(cuid())
  key             String   @unique
  description     String?
  isEnabled       Boolean  @default(false)
  defaultEnabled  Boolean  @default(false)
  rollout         Int      @default(100) // 0-100 (% of tenants)
  tenantOverride  Json?    @default("{}") // { tenantId: boolean }
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("FeatureFlag")
}

// ── Scheduled Report (super admin email/csv report schedules) ─
model ScheduledReport {
  id         String   @id @default(cuid())
  name       String
  type       String   @default("companies") // companies | calls | agents | leads | summary
  frequency  String   @default("weekly")   // daily | weekly | monthly
  recipients String[] @default([])         // emails
  format     String   @default("csv")       // csv | summary
  enabled    Boolean  @default(true)
  createdById String?
  lastRunAt  DateTime?
  lastStatus String?  // success | failed | sent
  nextRunAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("ScheduledReport")
}
